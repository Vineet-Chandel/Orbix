# Server Configuration
PORT=3000
NODE_ENV=development
# Show labeled fixtures created by npm run seed:leaderboard in non-production environments.
ORBIX_LEADERBOARD_DEMO=false
# Production defaults to false. Apply db:init-schema/migrations in the release step.
# Set true only for an intentional schema bootstrap, never every production replica.
DB_SCHEMA_SYNC_ON_STARTUP=false
# Per process: account for all web replicas and worker processes in the DB budget.
DB_POOL_MAX=20

# JWT Authentication
# Mandatory in production for signing and verifying user authentication JWTs.
# Required: unique random signing key (at least 32 characters in production). No fallback.
JWT_SECRET=

# Supabase PostgreSQL Database (Main Database)
# Transaction pooler connection string (port 6543) or direct session connection string (port 5432)
SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key
SUPABASE_SECRET_KEY=your_supabase_secret_service_role_key
SUPABASE_JWKS_URL=https://[project-ref].supabase.co/auth/v1/.well-known/jwks.json

# Optional: Standard PostgreSQL connection URL fallback (used only if SUPABASE_DB_URL is unset)
# DATABASE_URL=postgresql://user:password@localhost:5432/orbix

# Redis Cache & Rate Limiting
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# Cloudinary Profile Photo & Private Verification Document Storage
# CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, and CLOUDINARY_API_SECRET are MANDATORY in production for College Verification documents.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_AVATAR_FOLDER=orbix/avatars
CLOUDINARY_AVATAR_MAX_BYTES=5242880
CLOUDINARY_VERIFICATION_FOLDER=orbix/college_verifications

# Firebase Admin Configuration (Server-Side Phone Auth Verification)
FIREBASE_PROJECT_ID=your-firebase-project-id
# Option A: Path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=
# Option B: Raw JSON string of service account credentials
FIREBASE_SERVICE_ACCOUNT_KEY=
# Option C: Direct service account fields
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Email Provider Configuration (Multi-Provider: Resend & SMTP)
# Mandatory in production: at least ONE verified provider is required (Resend with custom domain OR full SMTP).
# Production rejects missing providers and rejects unverified Resend sandbox senders (@resend.dev / yourdomain.com).
# Provider Selection: 'auto' (default), 'smtp', or 'resend'
EMAIL_PROVIDER=auto

# Option 1: Resend API Configuration
# For production delivery to ANY student/user email, verify a domain at resend.com/domains and set RESEND_FROM_EMAIL.
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Orbix Team <team@yourdomain.com>

# Option 2: SMTP Configuration (Nodemailer)
# Direct SMTP delivery to ANY recipient worldwide without requiring custom domain DNS setup.
# Mandatory fields when using SMTP in production: SMTP_HOST (unless @gmail.com), SMTP_USER, SMTP_PASS, and SMTP_FROM_EMAIL.
# Example for Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=your_email@gmail.com
#   SMTP_PASS=xxxx xxxx xxxx xxxx (16-character Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="Orbix Security"
SMTP_FROM_EMAIL=

# Twilio SMS OTP Configuration (College Verification Mandatory Phone OTP)
# ALL THREE variables are MANDATORY in production (NODE_ENV=production).
# Missing or placeholder credentials cause SMS verification dispatch to fail closed in production.
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+10000000000

# Frontend Application Client URL (For OAuth redirects, CORS origin, and email verification links)
# In development: http://localhost:5173
# In production:  REQUIRED and MUST use HTTPS (e.g. https://theorbix.world)
FRONTEND_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# Google OAuth 2.0 Credentials
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized redirect URIs:
#   Development: http://localhost:3000/api/auth/google/callback
#   Production:  https://yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# GitHub OAuth App Credentials
# Create application in GitHub -> Settings -> Developer settings -> OAuth Apps
# Authorization callback URL:
#   Development: http://localhost:3000/api/auth/github/callback
#   Production:  https://yourdomain.com/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback


# OCR Engine Cache Directory (Optional)
# Directory where Tesseract downloads eng.traineddata language files.
# Defaults to OS tempdir (e.g. /tmp/orbix-tesseract-cache) to prevent writing to read-only container roots.
TESSERACT_CACHE_PATH=

# Additional trusted browser origins (comma separated); FRONTEND_URL is always allowed.
CORS_ALLOWED_ORIGINS=
# Log every API completion for latency percentiles. Slow requests and 5xx always log.
API_PERFORMANCE_LOG_ALL=false

# SheerID student enrollment (server-only). Apply migration 070 before enabling.
# Use a student-only program with API Access Control enabled and SMS/mobile loops disabled.
# The API token needs Verification Details + Customer PII permission for account/institution binding.
SHEERID_PROGRAM_ID=
SHEERID_API_TOKEN=
SHEERID_WEBHOOK_SECRET=

# Trusted club application reviewers. This list does not grant platform administrator access.
ORBIX_REVIEWER_EMAILS=
# Required to accept signed Resend workspace webhooks.
RESEND_WEBHOOK_SECRET=

# Administrator allowlist. Only list identities approved for super-admin access.
ORBIX_STAFF_EMAILS=

# Canonical public website. Use the same SITE_URL at frontend build and backend runtime.
SITE_URL=https://theorbix.world
# Enable only on the canonical production deployment; previews must stay false.
SEO_INDEXING_ENABLED=false
# Serve the built React public HTML/assets from Express (route the website origin here).
SERVE_FRONTEND=false
# Enable only behind a proxy that forwards the original Host; HTTPS redirects belong at TLS edge.
SEO_ENFORCE_CANONICAL_HOST=false
