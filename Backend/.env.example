# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Authentication
# Mandatory in production for signing and verifying user authentication JWTs.
JWT_SECRET=your_jwt_secret_key_here

# PostgreSQL Database (Supabase or standard Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/orbix
PGHOST=localhost
PGDATABASE=orbix
PGUSER=postgres
PGPASSWORD=your_password
PGPORT=5432

# Redis Cache & Rate Limiting
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# Cloudinary Profile Photo & Private Verification Document Storage
# CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, and CLOUDINARY_API_SECRET are MANDATORY in production for College Verification documents.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_AVATAR_FOLDER=orbix/avatars
CLOUDINARY_AVATAR_MAX_BYTES=5242880
CLOUDINARY_VERIFICATION_FOLDER=orbix/college_verifications

# Document-Proxy HMAC Signing Secret (College Verification Private Local Previews)
# MANDATORY in production (minimum 32 random characters; does NOT fall back to JWT_SECRET).
# Used exclusively for HMAC-SHA256 signing and verification of short-lived document-proxy URLs.
# In non-production only, if unset, an ephemeral per-process dev key is generated with a warning.
DOCUMENT_PROXY_HMAC_SECRET=your_document_proxy_hmac_secret_here_minimum_32_characters

# Firebase Admin Configuration (Server-Side Phone Auth Verification)
FIREBASE_PROJECT_ID=your-firebase-project-id
# Option A: Path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=
# Option B: Raw JSON string of service account credentials
FIREBASE_SERVICE_ACCOUNT_KEY=
# Option C: Direct service account fields
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Email Provider Configuration (Multi-Provider: Resend & SMTP)
# Mandatory in production: at least ONE verified provider is required (Resend with custom domain OR full SMTP).
# Production rejects missing providers and rejects unverified Resend sandbox senders (@resend.dev / yourdomain.com).
# Provider Selection: 'auto' (default), 'smtp', or 'resend'
EMAIL_PROVIDER=auto

# Option 1: Resend API Configuration
# For production delivery to ANY student/user email, verify a domain at resend.com/domains and set RESEND_FROM_EMAIL.
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Orbix Team <team@yourdomain.com>

# Option 2: SMTP Configuration (Nodemailer)
# Direct SMTP delivery to ANY recipient worldwide without requiring custom domain DNS setup.
# Mandatory fields when using SMTP in production: SMTP_HOST (unless @gmail.com), SMTP_USER, SMTP_PASS, and SMTP_FROM_EMAIL.
# Example for Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=your_email@gmail.com
#   SMTP_PASS=xxxx xxxx xxxx xxxx (16-character Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="Orbix Security"
SMTP_FROM_EMAIL=

# Twilio SMS OTP Configuration (College Verification Mandatory Phone OTP)
# ALL THREE variables are MANDATORY in production (NODE_ENV=production).
# Missing or placeholder credentials cause SMS verification dispatch to fail closed in production.
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+10000000000

# Frontend Application Client URL (For OAuth redirects, CORS origin, and email verification links)
# In development: http://localhost:5173
# In production:  REQUIRED and MUST use HTTPS (e.g. https://orbix.dev)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# Google OAuth 2.0 Credentials
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized redirect URIs:
#   Development: http://localhost:3000/api/auth/google/callback
#   Production:  https://yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# GitHub OAuth App Credentials
# Create application in GitHub -> Settings -> Developer settings -> OAuth Apps
# Authorization callback URL:
#   Development: http://localhost:3000/api/auth/github/callback
#   Production:  https://yourdomain.com/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback


# Orbix Founders Review Allowlist
# Comma-separated list of valid account UUIDs authorized to review student college verification requests.
# Must be standard UUID format. No email addresses or insecure fallback defaults are accepted.
# If omitted or invalid, founder review access is strictly disabled.
ORBIX_FOUNDER_USER_IDS=00000000-0000-0000-0000-000000000000

# OCR Engine Cache Directory (Optional)
# Directory where Tesseract downloads eng.traineddata language files.
# Defaults to OS tempdir (e.g. /tmp/orbix-tesseract-cache) to prevent writing to read-only container roots.
TESSERACT_CACHE_PATH=
