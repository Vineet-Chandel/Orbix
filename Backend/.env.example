# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here

# PostgreSQL Database (Supabase or standard Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/orbix
PGHOST=localhost
PGDATABASE=orbix
PGUSER=postgres
PGPASSWORD=your_password
PGPORT=5432

# Redis Cache & Rate Limiting
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# Cloudinary Profile Photo Management
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_AVATAR_FOLDER=orbix/avatars
CLOUDINARY_AVATAR_MAX_BYTES=5242880

# Firebase Admin Configuration (Server-Side Phone Auth Verification)
FIREBASE_PROJECT_ID=your-firebase-project-id
# Option A: Path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=
# Option B: Raw JSON string of service account credentials
FIREBASE_SERVICE_ACCOUNT_KEY=
# Option C: Direct service account fields
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
