# Orbix Frontend Client Environment Configuration

# Firebase Web App Client Configuration (Used for Firebase Phone Authentication)
# Obtain these values from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Standardized API Prefix Configuration
VITE_API_BASE_URL=/api


# Canonical public website. Use the same SITE_URL at frontend build and backend runtime.
SITE_URL=https://theorbix.world
# Enable only on the canonical production deployment; previews must stay false.
SEO_INDEXING_ENABLED=false
